# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

# Local Postgres via docker compose
POSTGRES_PASSWORD=postgres
POSTGRES_DB=samarth

# Supabase. Leave the URL local for an offline demo; point it at a hosted
# project when you need Auth and Storage.
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
# Service role bypasses RLS. Server-side only, never in the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Alert budget. The brief weighs precision as heavily as recall.
ALERTS_PER_COORDINATOR_PER_DAY=10
ALERT_COOLDOWN_DAYS=3
ESCALATE_AFTER_CONSECUTIVE_DAYS=3

# Layer B baseline window
BASELINE_WINDOW_DAYS=21
BASELINE_MIN_OBSERVATIONS=7
