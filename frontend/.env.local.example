# Copy to .env.local and fill in. Never commit the filled copy — .gitignore
# excludes .env.* so only this example travels.
#
# The first two are also what a Vercel deployment needs at minimum. Set them
# under Project → Settings → Environment Variables.

# ---- Supabase (required) ---------------------------------------------------

# Browser-visible, both of them. The anon key is safe to expose ONLY because
# row-level security is on and every policy keys off auth.uid(). Verified: an
# anon caller reads zero rows from every table and is denied the ops view.
# See backend/supabase/migrations/0002_rls.sql and 0003_ops_view_grants.sql.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Groq (required for the assistant and the voice check-in) --------------

# SERVER-ONLY, and it has to stay that way: a key in the browser bundle is a
# key anyone can drain. Every call goes through /api/chat or /api/transcribe,
# neither of which returns or echoes it.
GROQ_API_KEY=

# Both optional; these are the defaults. Groq retires model ids without much
# notice, so if the assistant starts 404ing, list
# https://api.groq.com/openai/v1/models and pick a current one.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ---- Admin scripts only (NOT needed by the app or by Vercel) ---------------

# Everything below is read by npm run db:migrate / db:seed / db:load-cohort.
# The running app never touches them, so leave them out of any deployment.

# Bypasses RLS completely. NEVER prefix it NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=https://<project-ref>.supabase.co

SUPABASE_DB_HOST=db.<project-ref>.supabase.co
SUPABASE_DB_PASSWORD=
# Defaults shown; override only if your project differs.
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres

# ---- Optional --------------------------------------------------------------

# The FastAPI service, if you are running one. Unset means no /api/* proxy at
# all, which is correct for a deployment that does not have a backend — the
# app's own /api/chat and /api/transcribe are unaffected either way.
# BACKEND_URL=http://localhost:8000
